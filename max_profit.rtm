.section ".data"
tam:
    .word 6
precios:
    .word 7
    .word 1
    .word 5
    .word 3
    .word 6
    .word 4
max_ganancia:
    .word 0

.section ".text"
    addi $s0, $zero, 0
    lw $s1, tam($zero)

    lw $t0, precios($zero)
    addi $t1, $zero, 0

    addi $s0, $s0, 1

bucle:
    beq $s0, $s1, fin_bucle

    add $t2, $s0, $s0
    add $t2, $t2, $t2

    orh $a0, $zero, .hi16 precios
    ori $a0, $a0, .lo16 precios
    add $a0, $a0, $t2
    lw $t3, 0($a0)

    blt $t3, $t0, nuevo_minimo

    nor $t4, $t0, $zero
    addi $t4, $t4, 1
    add $t4, $t3, $t4

    blt $t1, $t4, nuevo_maximo
    j siguiente

nuevo_minimo:
    addi $t0, $t3, 0
    j siguiente

nuevo_maximo:
    addi $t1, $t4, 0

siguiente:
    addi $s0, $s0, 1
    j bucle

fin_bucle:
    sw $t1, max_ganancia($zero)

fin:
    j fin
